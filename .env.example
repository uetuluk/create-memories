# GHCR image — set to your GitHub username/org (lowercase). Used by compose.production.yml.
IMAGE_OWNER=shanghai-rits

# Public URL Caddy serves on. Caddy auto-issues a Let's Encrypt cert for this hostname.
BASE_URL=https://create-memories.ritsdev.top

# Postgres
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=app
DATABASE_URL=postgres://app:change-me@db:5432/app

# Auth.js
AUTH_SECRET=                                     # openssl rand -base64 32
AUTH_URL=https://create-memories.ritsdev.top
AUTH_TRUST_HOST=true

# Magic-link email (smtp-relay sidecar in compose.production.yml)
EMAIL_SERVER=smtp://smtp-relay:25
EMAIL_FROM=no-reply@create-memories.ritsdev.top

# Access control
ALLOWED_EMAIL_DOMAINS=nyu.edu
ADMIN_EMAILS=utkuegetuluk@gmail.com

# Google AI Studio
GEMINI_API_KEY=

# Public URL the app uses to build absolute links (e.g. QR target)
PUBLIC_URL=https://create-memories.ritsdev.top

# Optional: Google Forms survey URL. If set, a second QR appears on the
# Maxhub gallery linking to the post-event survey. Leave blank to hide.
SURVEY_URL=

# Cloudflare API token used by Caddy for DNS-01 ACME challenge. Required
# because the deploy host has an internal IP that the public Let's Encrypt
# servers can't reach for HTTP-01. Mint a Zone:DNS:Edit token scoped to
# ritsdev.top at https://dash.cloudflare.com/profile/api-tokens.
CF_API_TOKEN=
