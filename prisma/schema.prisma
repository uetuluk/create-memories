generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js Prisma adapter models ──────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ─────────────────────────────────────────────────────
enum Mode {
  VIDEO
  IMAGE
  OFF
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
}

enum QilinStyle {
  FIERCE
  CUTE
}

model Job {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Free-text "vibe" the student typed (optional). Was the full prompt
  // pre-pivot; now it's an optional descriptor on top of style + location.
  prompt        String
  rewritten     String?
  mode          Mode
  status        JobStatus @default(QUEUED)
  // Qilin transform inputs.
  style         QilinStyle? // null = legacy free-prompt jobs
  location      String? // ref key from src/lib/refs.ts; null means random
  selfiePath    String? // local path; deleted on completion
  // Generated artifact.
  filePath      String?
  mimeType      String?
  // For VIDEO jobs spawned from an IMAGE job (image-to-video chain).
  parentJobId   String?
  parent        Job?      @relation("JobChildren", fields: [parentJobId], references: [id], onDelete: SetNull)
  children      Job[]     @relation("JobChildren")
  costUsd       Decimal?  @db.Decimal(6, 4)
  errorCode     String?
  errorMsg      String?
  hidden        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  usage         UsageEvent[]

  @@index([status, createdAt])
  @@index([completedAt(sort: Desc)])
  @@index([userId, status])
  @@index([parentJobId])
}

model AppState {
  id            Int      @id @default(1)
  mode          Mode     @default(VIDEO)
  videoCount    Int      @default(0)
  videoCap      Int      @default(200)
  perUserQuota  Int      @default(10)
  totalCostUsd  Decimal  @default(0) @db.Decimal(8, 4)
  updatedAt     DateTime @updatedAt
}

enum UsageKind {
  TEXT
  IMAGE
  VIDEO
}

// One row per real Google API call. Lets us reconcile against the
// console-reported spend after the event and break down cost by model.
model UsageEvent {
  id              String    @id @default(cuid())
  jobId           String?
  job             Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  kind            UsageKind
  model           String
  // Text models report these; null for image/video.
  inputTokens     Int?
  outputTokens    Int?
  cachedTokens    Int?
  // Video reports duration; null for text/image.
  durationSeconds Int?
  // Estimated cost for this single call (USD).
  costUsd         Decimal   @db.Decimal(8, 6)
  // Pricing rate used so we can recompute later if rates change.
  pricingNote     String?
  ok              Boolean   @default(true)
  errorCode       String?
  createdAt       DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@index([jobId])
}
