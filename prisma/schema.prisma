generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js Prisma adapter models ──────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ─────────────────────────────────────────────────────
enum Mode {
  VIDEO
  IMAGE
  OFF
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      String
  rewritten   String?
  mode        Mode
  status      JobStatus @default(QUEUED)
  filePath    String?
  mimeType    String?
  costUsd     Decimal?  @db.Decimal(6, 4)
  errorCode   String?
  errorMsg    String?
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status, createdAt])
  @@index([completedAt(sort: Desc)])
  @@index([userId, status])
}

model AppState {
  id           Int      @id @default(1)
  mode         Mode     @default(VIDEO)
  videoCount   Int      @default(0)
  videoCap     Int      @default(200)
  totalCostUsd Decimal  @default(0) @db.Decimal(8, 4)
  updatedAt    DateTime @updatedAt
}
